{
	"name": "craue/geo-bundle",
	"type": "symfony-bundle",
	"description": "Doctrine functions for calculating geographical distances in your Symfony project.",
	"keywords": ["geo", "symfony"],
	"homepage": "https://github.com/craue/CraueGeoBundle",
	"license": "MIT",
	"authors": [
		{
			"name": "Christian Raue",
			"email": "christian.raue@gmail.com"
		},
		{
			"name": "Symfony Community",
			"homepage": "https://github.com/craue/CraueGeoBundle/contributors"
		}
	],
	"require": {
		"php": "^8.2|^8.3|^8.4",
		"doctrine/doctrine-bundle": "^2.15.0",
		"doctrine/orm": "^3.5.0",
		"symfony/config": "^7",
		"symfony/dependency-injection": "^7",
		"symfony/framework-bundle": "^7"
	},
	"require-dev": {
		"doctrine/annotations": "^2",
		"doctrine/data-fixtures": "^2",
		"doctrine/dbal": "^4",
		"doctrine/doctrine-fixtures-bundle": "^4",
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan": "^2",
		"phpstan/phpstan-deprecation-rules": "^2",
		"phpstan/phpstan-strict-rules": "^2",
		"phpstan/phpstan-symfony": "^2",
		"phpunit/phpunit": "^12",
		"symfony/browser-kit": "^7",
		"symfony/phpunit-bridge": "^7",
		"symfony/yaml": "^7"
	},
	"suggest": {
		"doctrine/data-fixtures": "*"
	},
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"Craue\\GeoBundle\\": ""
		},
		"exclude-from-classmap": [
			"/Tests/"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0.x-dev"
		},
		"symfony": {
			"require": "^7"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"symfony/flex": true
		},
		"sort-packages": true
	}
}
